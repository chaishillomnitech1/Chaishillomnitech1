# ─────────────────────────────────────────────────────────────────────────────
# 🔐 DEPLOYMENT WALLET CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────

# Private key for deployment (DO NOT COMMIT .env FILE)
# Get from MetaMask: Account Details > Export Private Key
# Format: 64 hexadecimal characters WITHOUT the 0x prefix
# Example format: a1b2c3d4e5f6789012345678901234567890abcdef1234567890abcdef123456
PRIVATE_KEY=your_private_key_here

# Deployer private key for multi-chain deployments
# Format: 64 hexadecimal characters WITHOUT the 0x prefix
DEPLOYER_PRIVATE_KEY=your_deployer_private_key_here

# Deployer wallet address
DEPLOYER_WALLET_ADDRESS=0x0000000000000000000000000000000000000000

# ─────────────────────────────────────────────────────────────────────────────
# 🌐 BLOCKCHAIN RPC ENDPOINTS
# ─────────────────────────────────────────────────────────────────────────────

# Polygon Network
POLYGON_MUMBAI_RPC_URL=https://rpc-mumbai.maticvigil.com
POLYGON_MAINNET_RPC_URL=https://polygon-rpc.com

# Scroll Mainnet RPC URL
SCROLL_MAINNET_RPC_URL=https://rpc.scroll.io

# Scroll Sepolia RPC URL (Testnet)
SCROLL_SEPOLIA_RPC_URL=https://sepolia-rpc.scroll.io
# Scroll Network (zkEVM)
SCROLL_RPC_URL=https://rpc.scroll.io
SCROLL_SEPOLIA_RPC_URL=https://sepolia-rpc.scroll.io
SCROLL_MAINNET_RPC_URL=https://rpc.scroll.io

# Ethereum Network
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
GOERLI_RPC_URL=https://goerli.infura.io/v3/YOUR_INFURA_KEY

# ─────────────────────────────────────────────────────────────────────────────
# 🔍 BLOCKCHAIN EXPLORER API KEYS
# ─────────────────────────────────────────────────────────────────────────────

# PolygonScan API Key for contract verification
# Get from: https://polygonscan.com/apis
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here

# ScrollScan API Key for contract verification
# Get from: https://scrollscan.com/apis
SCROLLSCAN_API_KEY=your_scrollscan_api_key_here

# Vault addresses for CHX Token
# Etherscan API Key
# Get from: https://etherscan.io/apis
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# 🔑 THIRD-PARTY API KEYS
# ─────────────────────────────────────────────────────────────────────────────

# Infura API Key (Ethereum/IPFS access)
# Get from: https://infura.io/
INFURA_KEY=your_infura_key_here

# Alchemy API Key (Enhanced blockchain access)
# Get from: https://www.alchemy.com/
ALCHEMY_KEY=your_alchemy_key_here

# ─────────────────────────────────────────────────────────────────────────────
# 💎 CHX TOKEN VAULT ADDRESSES
# ─────────────────────────────────────────────────────────────────────────────

# Creator vault (receives 10% of royalties)
CREATOR_VAULT_ADDRESS=0x0000000000000000000000000000000000000000

# Ambassador vault (receives 5% of royalties)
AMBASSADOR_VAULT_ADDRESS=0x0000000000000000000000000000000000000000

# DAO vault (receives 2% of royalties)
DAO_VAULT_ADDRESS=0x0000000000000000000000000000000000000000

# Noor Token Configuration
NOOR_ZAKAT_RECIPIENT_1=0x0000000000000000000000000000000000000000
NOOR_ZAKAT_RECIPIENT_2=0x0000000000000000000000000000000000000000
NOOR_NODE_OPERATOR_1=0x0000000000000000000000000000000000000000
# ─────────────────────────────────────────────────────────────────────────────
# 📜 SMART CONTRACT ADDRESSES (Set after deployment)
# ─────────────────────────────────────────────────────────────────────────────

# NFT Contracts
SCROLLVERSE_NFT_CONTRACT=0x0000000000000000000000000000000000000000
PROMISE_LAND_NFT_CONTRACT=0x0000000000000000000000000000000000000000
AZURATH_NFT_CONTRACT=0x0000000000000000000000000000000000000000
SACRED_CERTIFICATION_NFT=0x0000000000000000000000000000000000000000

# Token Contracts
CHX_TOKEN_CONTRACT=0x0000000000000000000000000000000000000000
BLESSING_COIN_CONTRACT=0x0000000000000000000000000000000000000000
NOOR_TOKEN_CONTRACT=0x0000000000000000000000000000000000000000
NOOR_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
CODEX_TOKEN_CONTRACT=0x0000000000000000000000000000000000000000
PEACE_COIN_CONTRACT=0x0000000000000000000000000000000000000000

# Staking & Incentive Contracts
NOOR_STAKING_POOL_ADDRESS=0x0000000000000000000000000000000000000000
STAKING_POOL_ADDRESS=0x0000000000000000000000000000000000000000
LIQUIDITY_INCENTIVES_ADDRESS=0x0000000000000000000000000000000000000000

# Liquidity Contracts
ADD_LIQUIDITY_ADDRESS=0x0000000000000000000000000000000000000000
UNISWAP_ROUTER_ADDRESS=0x0000000000000000000000000000000000000000
QUICKSWAP_ROUTER_ADDRESS=0xa5E0829CaCEd8fFDD4De3c43696c57F7D7A678ff

# Fund Addresses
SABIR_ALLAH_HONOR_FUND=0x0000000000000000000000000000000000000000
CITIZEN_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000

# Deployment Registry
DEPLOYMENT_REGISTRY_CONTRACT=0x0000000000000000000000000000000000000000

# Incentive Configuration
REWARD_PER_BLOCK=1000000000000000000
INCENTIVE_START_BLOCK=0
MAX_SLIPPAGE=500

# Reference Identity Policy (for governance)
REFERENCE_IDENTITY_POLICY=your_policy_reference_here

# ─────────────────────────────────────────────────────────────────────────────
# ☁️ CLOUD PROVIDER CREDENTIALS (for CI/CD)
# ─────────────────────────────────────────────────────────────────────────────

# AWS Configuration
# Get from: https://console.aws.amazon.com/iam/
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/your-role

# Azure Configuration
# Get from: Azure Portal > App Service > Deployment Center
AZURE_WEBAPP_PUBLISH_PROFILE=your_azure_publish_profile

# IBM Cloud Configuration
# Get from: https://cloud.ibm.com/iam/apikeys
IBM_CLOUD_API_KEY=your_ibm_cloud_api_key
ICR_NAMESPACE=your_icr_namespace

# Alibaba Cloud Configuration
# Get from: https://ram.console.aliyun.com/
ACCESS_KEY_ID=your_alibaba_access_key_id
ACCESS_KEY_SECRET=your_alibaba_access_key_secret

# OpenShift Configuration
OPENSHIFT_SERVER=https://api.your-cluster.openshift.com:6443
OPENSHIFT_TOKEN=your_openshift_token

# Vercel Configuration
# Get from: https://vercel.com/account/tokens
VERCEL_TOKEN=your_vercel_token
VERCEL_ORG_ID=your_vercel_org_id
VERCEL_PROJECT_ID=your_vercel_project_id

# Terraform Cloud Configuration
# Get from: https://app.terraform.io/app/settings/tokens
TF_API_TOKEN=your_terraform_api_token

# ─────────────────────────────────────────────────────────────────────────────
# 🔥 FIREBASE CONFIGURATION (for Sovereign TV App)
# ─────────────────────────────────────────────────────────────────────────────

# Get all values from: https://console.firebase.google.com/
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# ─────────────────────────────────────────────────────────────────────────────
# 🛡️ SECURITY & SCANNING
# ─────────────────────────────────────────────────────────────────────────────

# Snyk Token for vulnerability scanning
# Get from: https://app.snyk.io/account
SNYK_TOKEN=your_snyk_token

# CRDA (CodeReady Dependency Analytics) Key
CRDA_KEY=your_crda_key

# Image Registry Password (for container deployments)
IMAGE_REGISTRY_PASSWORD=your_registry_password

# ─────────────────────────────────────────────────────────────────────────────
# 🤖 AI INTEGRATION (GROK API)
# ─────────────────────────────────────────────────────────────────────────────

# Grok API Configuration (X AI)
# Get from: https://x.ai/api
GROK_API_KEY=grok_sk_your_api_key_here
GROK_API_ENDPOINT=https://api.x.ai/v1/

# ─────────────────────────────────────────────────────────────────────────────
# 🔗 OMNITECH1 INTEGRATION
# ─────────────────────────────────────────────────────────────────────────────

# Flask Configuration
# Secret key for session encryption (auto-generated if not set)
FLASK_SECRET_KEY=your_flask_secret_key_here

# GitHub Webhook Security
# HMAC secret for webhook signature verification (X-Hub-Signature-256)
# Must match the secret configured in GitHub webhook settings
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# Admin Authentication
# Token for admin endpoint authentication via X-Admin-Token header
ADMIN_TOKEN=your_admin_token_here

# JWT Configuration
# Secret for signing JWT tokens for admin authentication
JWT_SECRET=your_jwt_secret_here

# Neo4j Graph Database
# Connection URI (use bolt:// for local, bolt+s:// for cloud)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# Server Configuration
PORT=5000
FLASK_DEBUG=false

# ─────────────────────────────────────────────────────────────────────────────
# 💳 STRIPE / ZAKAT LEDGER (ScrollSoul Nexus)
# ─────────────────────────────────────────────────────────────────────────────

# Stripe secret key — used for Zakat ledger reconciliation
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here

# Stripe publishable key — used for frontend payment widgets
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key_here

# Stripe webhook signing secret — validates incoming Stripe webhook events
# Get from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# Zakat percentage to deduct from gross revenue (default: 2.5%)
ZAKAT_PERCENTAGE=2.5

# On-chain wallet address that receives Zakat distributions
# IMPORTANT: Replace with a real wallet address — never use the zero address in production
ZAKAT_RECIPIENT_ADDRESS=0xYOUR_ZAKAT_RECIPIENT_WALLET_ADDRESS_HERE

# ─────────────────────────────────────────────────────────────────────────────
# 📡 HIGHLEVEL WEBHOOKS (ScrollSoul Nexus — PR Handling)
# ─────────────────────────────────────────────────────────────────────────────

# HighLevel inbound webhook URL — receives PR and deployment events
# Get from: HighLevel > Settings > Integrations > Webhooks
HIGHLEVEL_WEBHOOK_URL=https://app.highlevel.com/webhooks/your_webhook_id_here

# HighLevel API key for outbound API calls
# Get from: HighLevel > Settings > API
HIGHLEVEL_API_KEY=your_highlevel_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# 🔧 SCROLLVERSE BACKEND API (ScrollSoul Nexus — Automation)
# ─────────────────────────────────────────────────────────────────────────────

# Base URL for the ScrollVerse backend API
SCROLLVERSE_BACKEND_URL=https://api.scrollverse.com

# Shared secret used by the backend sync endpoint (X-API-Secret header)
BACKEND_API_SECRET=your_backend_api_secret_here

# ─────────────────────────────────────────────────────────────────────────────
# 🤖 PHASE 2: AI & AUTOMATION
# ─────────────────────────────────────────────────────────────────────────────

# OpenAI API Key (for AI PR bot)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# 🎁 PHASE 2: REWARDS SYSTEM (TESTNET)
# ─────────────────────────────────────────────────────────────────────────────

# Rewards wallet address (testnet only)
REWARDS_WALLET_ADDRESS=0x0000000000000000000000000000000000000000

# Rewards wallet private key (testnet only)
REWARDS_PRIVATE_KEY=your_testnet_private_key_here

# Enable/disable reward minting
REWARDS_MINT_ENABLED=false

# ─────────────────────────────────────────────────────────────────────────────
# 🔄 PHASE 2: REPO-SYNC
# ─────────────────────────────────────────────────────────────────────────────

# GitHub Personal Access Token (for repo-sync hub)
# Get from: https://github.com/settings/tokens
# Required scopes: repo, workflow
GITHUB_PAT=ghp_your_github_personal_access_token_here

