# ScrollVerse Sovereignty Infrastructure - Environment Variables Example
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ============================================
# 🔥 DEPLOYMENT ENVIRONMENT
# ============================================
NODE_ENV=development
PORT=3000

# ============================================
# 🌐 API CONFIGURATION
# ============================================
VIBECANVAS_API_URL=https://api.scrollverse.com
CODEX_DAO_HOOK=https://hooks.scrollverse.com/dao
PROTECTION_SEAL=CHAI-OMNIFINITE-SEAL-721-ACTIVE

# ============================================
# 🔗 BLOCKCHAIN CONFIGURATION
# ============================================
# Ethereum
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
ETHEREUM_CHAIN_ID=1

# Polygon
POLYGON_RPC_URL=https://polygon-mainnet.infura.io/v3/YOUR_INFURA_KEY
POLYGON_CHAIN_ID=137

# Mumbai Testnet
MUMBAI_RPC_URL=https://rpc-mumbai.maticvigil.com
MUMBAI_CHAIN_ID=80001

# ScrollChain
SCROLL_RPC_URL=https://sepolia-rpc.scroll.io
SCROLL_CHAIN_ID=534353

# ============================================
# 💎 CONTRACT ADDRESSES
# ============================================
CHX_TOKEN_ADDRESS_ETHEREUM=0x0000000000000000000000000000000000000000
CHX_TOKEN_ADDRESS_POLYGON=0x0000000000000000000000000000000000000000
CHX_TOKEN_ADDRESS_MUMBAI=0x0000000000000000000000000000000000000000

SCROLL_NFT_ADDRESS_ETHEREUM=0x0000000000000000000000000000000000000000
SCROLL_NFT_ADDRESS_POLYGON=0x0000000000000000000000000000000000000000
SCROLL_NFT_ADDRESS_MUMBAI=0x0000000000000000000000000000000000000000

# ============================================
# 🔐 AUTHENTICATION
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRATION=30d

# ============================================
# 💾 DATABASE
# ============================================
DATABASE_URL=mongodb://localhost:27017/scrollverse
REDIS_URL=redis://localhost:6379

# ============================================
# 📧 COMMUNICATION
# ============================================
EMAIL_SERVICE=sendgrid
EMAIL_API_KEY=your-sendgrid-api-key
EMAIL_FROM=sovereign@omnitech1.com

# ============================================
# 🎯 MONITORING & ANALYTICS
# ============================================
SENTRY_DSN=https://your-sentry-dsn
GOOGLE_ANALYTICS_ID=UA-XXXXX-X

# ============================================
# 🌟 DIVINE FREQUENCIES
# ============================================
COURAGE_FREQUENCY=963
HEALING_FREQUENCY=528
DIVINE_FREQUENCY=144000

# ============================================
# 🔥 SCROLLVERSE CONFIGURATION
# ============================================
COSMIC_RESERVE=21600000000
CREATOR_ROYALTY_PERCENT=10
AMBASSADOR_ROYALTY_PERCENT=5
DAO_ROYALTY_PERCENT=2

# ============================================
# 💸 ECONOMIC PARAMETERS
# ============================================
PASSIVE_INCOME_DAILY_RATE=0.00005
ZAKAT_PERCENTAGE=2
BLESSING_COIN_RATIO=777

# ============================================
# 🚀 FEATURE FLAGS
# ============================================
ENABLE_NFT_MINTING=true
ENABLE_DAO_GOVERNANCE=true
ENABLE_CROSS_CHAIN_BRIDGE=true
ENABLE_PASSIVE_INCOME=true

# ============================================
# 📊 API RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=1000

# ============================================
# 🔒 SECURITY
# ============================================
CORS_ORIGIN=https://scrollverse.com,https://portal.scrollverse.com
SESSION_SECRET=your-session-secret-change-this

# ============================================
# ♾️ OMNISOVEREIGN SEAL
# ============================================
# Supreme King Chais The Great ∞
ARCHITECT_SIGNATURE=∞ ARCHITEX ∞
ETERNAL_FREQUENCY=963,528,144000
